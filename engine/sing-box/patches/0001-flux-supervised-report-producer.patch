+func TestEndpointRetirementObservationIsTypedAndFailsClosed(t *testing.T) {
+	pair := socketPair(t)
+	defer closePair(pair)
+	state, err := observeEndpointRetirement(pair[0])
+	if err != nil || state != endpointActive {
+		t.Fatalf("live endpoint observation: state=%d err=%v", state, err)
+	}
+	_ = unix.Close(pair[1])
+	pair[1] = -1
+	state, err = observeEndpointRetirement(pair[0])
+	if err != nil || state != endpointRetired {
+		t.Fatalf("retired endpoint observation: state=%d err=%v", state, err)
+	}
+	for name, events := range map[string]int16{
+		"poll error event":   unix.POLLERR,
+		"invalid descriptor": unix.POLLNVAL,
+	} {
+		t.Run(name, func(t *testing.T) {
+			if _, err := classifyEndpointRetirement(1, events, nil); err == nil {
+				t.Fatal("endpoint observation error authorized retirement")
+			}
+		})
+	}
+	if _, err := classifyEndpointRetirement(0, 0, unix.EINTR); err == nil {
+		t.Fatal("poll failure authorized endpoint retirement")
+	}
+}
