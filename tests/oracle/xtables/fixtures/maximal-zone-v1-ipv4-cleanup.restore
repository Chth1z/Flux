*mangle
-D PREROUTING -j PROXY_PREROUTING
-D OUTPUT -j PROXY_OUTPUT
-F PROXY_PREROUTING
-F PROXY_OUTPUT
-F BYPASS_IP
-F APP_CHAIN
-F ACTION_PROXY_PRE
-F ACTION_PROXY_OUT
-F ACTION_BYPASS
-F BYP_Z0
-F BYP_Z1
-F BYP_Z2
-F BYP_Z3
-F BYP_Z4
-F BYP_Z5
-F BYP_Z6
-F BYP_Z7
-F BYP_Z8
-F BYP_Z9
-F BYP_Z10
-F BYP_Z11
-F BYP_Z12
-F BYP_Z13
-F BYP_Z14
-F BYP_Z15
-F DIVERT
-X PROXY_PREROUTING
-X PROXY_OUTPUT
-X BYPASS_IP
-X APP_CHAIN
-X ACTION_PROXY_PRE
-X ACTION_PROXY_OUT
-X ACTION_BYPASS
-X BYP_Z0
-X BYP_Z1
-X BYP_Z2
-X BYP_Z3
-X BYP_Z4
-X BYP_Z5
-X BYP_Z6
-X BYP_Z7
-X BYP_Z8
-X BYP_Z9
-X BYP_Z10
-X BYP_Z11
-X BYP_Z12
-X BYP_Z13
-X BYP_Z14
-X BYP_Z15
-X DIVERT
COMMIT
*filter
-D OUTPUT -d 127.0.0.1 -p tcp -m owner --uid-owner 1000 --gid-owner 1000 -m tcp --dport 1536 -j REJECT
COMMIT
*nat
-D OUTPUT -d 198.18.0.0/15 -p icmp -j DNAT --to-destination 127.0.0.1
-D PREROUTING -d 198.18.0.0/15 -p icmp -j DNAT --to-destination 127.0.0.1
COMMIT
*mangle
-D POSTROUTING -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
COMMIT
