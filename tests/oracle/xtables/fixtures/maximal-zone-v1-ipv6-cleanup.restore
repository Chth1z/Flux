*mangle
-D PREROUTING -j PROXY_PREROUTING6
-D OUTPUT -j PROXY_OUTPUT6
-F PROXY_PREROUTING6
-F PROXY_OUTPUT6
-F BYPASS_IP6
-F APP_CHAIN6
-F ACTION_PROXY_PRE6
-F ACTION_PROXY_OUT6
-F ACTION_BYPASS6
-F BYP_Z06
-F BYP_Z16
-F BYP_Z26
-F BYP_Z36
-F BYP_Z46
-F BYP_Z56
-F BYP_Z66
-F BYP_Z76
-F BYP_Z86
-F BYP_Z96
-F BYP_Z106
-F BYP_Z116
-F BYP_Z126
-F BYP_Z136
-F BYP_Z146
-F BYP_Z156
-F DIVERT6
-X PROXY_PREROUTING6
-X PROXY_OUTPUT6
-X BYPASS_IP6
-X APP_CHAIN6
-X ACTION_PROXY_PRE6
-X ACTION_PROXY_OUT6
-X ACTION_BYPASS6
-X BYP_Z06
-X BYP_Z16
-X BYP_Z26
-X BYP_Z36
-X BYP_Z46
-X BYP_Z56
-X BYP_Z66
-X BYP_Z76
-X BYP_Z86
-X BYP_Z96
-X BYP_Z106
-X BYP_Z116
-X BYP_Z126
-X BYP_Z136
-X BYP_Z146
-X BYP_Z156
-X DIVERT6
COMMIT
*filter
-D OUTPUT -d ::1 -p tcp -m owner --uid-owner 1000 --gid-owner 1000 -m tcp --dport 1536 -j REJECT
COMMIT
*nat
-D OUTPUT -d fc00::/18 -p ipv6-icmp -j DNAT --to-destination ::1
-D PREROUTING -d fc00::/18 -p ipv6-icmp -j DNAT --to-destination ::1
COMMIT
*mangle
-D POSTROUTING -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
COMMIT
