+func TestOriginalDestinationRetainsValidPrefixWhenKernelMarksControlTruncated(t *testing.T) {
+	ipv4 := make([]byte, 16)
+	binary.BigEndian.PutUint16(ipv4[2:4], 5353)
+	copy(ipv4[4:8], []byte{192, 0, 2, 19})
+	truncated := make([]byte, unix.CmsgLen(4))
+	header := (*unix.Cmsghdr)(unsafe.Pointer(&truncated[0]))
+	header.Level = unix.SOL_SOCKET
+	header.Type = unix.SCM_RIGHTS
+	header.SetLen(unix.CmsgLen(16))
+	oob := append(controlMessage(t, unix.SOL_IP, unix.IP_RECVORIGDSTADDR, ipv4), truncated...)
+	if _, _, _, _, found := originalDestination(oob, false); found {
+		t.Fatal("malformed control bytes without MSG_CTRUNC were accepted")
+	}
+	destination, count, family, length, found := originalDestination(oob, true)
+	if !found || destination.String() != "192.0.2.19:5353" || count != 1 || family != addressFamilyIPv4 || length != 16 {
+		t.Fatalf("truncated valid prefix was not preserved: destination=%s count=%d family=%d length=%d found=%t", destination, count, family, length, found)
+	}
+}
