#!/system/bin/sh

# ==============================================================================
# [ Flux Address Sync Controller ]
# Description: Lifecycle management for addrsyncd (start, stop, resync, cleanup).
# ==============================================================================

set -eu
[ -n "${BASH_VERSION:-}" ] && set -o pipefail

_script_path="${0}"
case "${_script_path}" in
/*) ;;
*) _script_path="${PWD}/${_script_path}" ;;
esac
readonly SCRIPT_DIR="${_script_path%/*}"

. "${SCRIPT_DIR}/lib"
. "${SCRIPT_DIR}/log"

readonly LOG_COMPONENT="ASyn"

# ==============================================================================
# [ Daemon Process Management ]
# ==============================================================================

_daemon_state() {
    local status=""
    local pid=""

    status=$("${ADDRSYNCD_BIN}" -c "${ADDRSYNCD_CONF_FILE}" -d "${RUN_DIR}" status 2>/dev/null) || {
        log_error "Cannot inspect addrsyncd status"
        return 1
    }

    case "${status}" in
    stopped)
        printf '%s\n' "stopped"
        ;;
    "running pid="*)
        pid="${status#running pid=}"
        case "${pid}" in
        '' | 0 | 0* | *[!0-9]*)
            log_error "addrsyncd returned an invalid running identity"
            return 1
            ;;
        esac
        printf 'running:%s\n' "${pid}"
        ;;
    *)
        # In particular, `stopped(config invalid: ...)` is not evidence that
        # the daemon is safely stopped; the config may prevent process lookup.
        log_error "addrsyncd returned an untrusted status"
        return 1
        ;;
    esac
}

_start_daemon() {
    local state=""
    state=$(_daemon_state) || return 1

    case "${state}" in
    running:*)
        log_info "addrsyncd already running"
        return 0
        ;;
    stopped) ;;
    *)
        log_error "addrsyncd status parser returned an invalid state"
        return 1
        ;;
    esac

    "${ADDRSYNCD_BIN}" -c "${ADDRSYNCD_CONF_FILE}" -d "${RUN_DIR}" run --daemon >/dev/null 2>&1
}

_wait_for_ready() {
    local state=""
    state=$(_daemon_state) || return 1
    case "${state}" in
    running:*) return 0 ;;
    stopped)
        log_error "addrsyncd is stopped after startup"
        return 1
        ;;
    *)
        log_error "addrsyncd status parser returned an invalid state"
        return 1
        ;;
    esac
}

_stop_daemon() {
    local state=""
    state=$(_daemon_state) || return 1
    case "${state}" in
    stopped)
        rm -f "${ADDRSYNCD_PID_FILE}" 2>/dev/null || true
        return 0
        ;;
    running:*) ;;
    *)
        log_error "addrsyncd status parser returned an invalid state"
        return 1
        ;;
    esac

    "${ADDRSYNCD_BIN}" -c "${ADDRSYNCD_CONF_FILE}" -d "${RUN_DIR}" stop >/dev/null 2>&1 || return 1

    local count=0
    local timeout="${CORE_TIMEOUT:-5}"
    while :; do
        state=$(_daemon_state) || return 1
        case "${state}" in
        stopped)
            rm -f "${ADDRSYNCD_PID_FILE}" 2>/dev/null || true
            return 0
            ;;
        running:*) ;;
        *)
            log_error "addrsyncd status parser returned an invalid state"
            return 1
            ;;
        esac

        count=$((count + 1))
        [ "${count}" -lt "${timeout}" ] || {
            log_error "addrsyncd remained running after stop"
            return 1
        }
        sleep 1
    done
}

# ==============================================================================
# [ Service Control ]
# ==============================================================================

start_addrsync() {
    run -v "Start addrsyncd" _start_daemon || return $?
    run -v "addrsync startup" _wait_for_ready || return $?
}

stop_addrsync() {
    run -v "Stop addrsyncd" _stop_daemon
}

resync_addrsync() {
    "${ADDRSYNCD_BIN}" \
        -c "${ADDRSYNCD_CONF_FILE}" \
        -d "${RUN_DIR}" \
        resync >/dev/null 2>&1
}

status_addrsync() {
    local state=""
    state=$(_daemon_state) || return 1
    case "${state}" in
    running:*)
        printf 'running pid=%s\n' "${state#running:}"
        ;;
    stopped)
        printf '%s\n' "stopped"
        return 1
        ;;
    *)
        log_error "addrsyncd status parser returned an invalid state"
        return 1
        ;;
    esac
}

cleanup_addrsync() {
    "${ADDRSYNCD_BIN}" \
        -c "${ADDRSYNCD_CONF_FILE}" \
        -d "${RUN_DIR}" \
        cleanup --mode dump >/dev/null 2>&1
}

_release_networking_writer() {
    release_shell_xtables_writer_lock
}

_claim_networking_writer() {
    if [ -n "${FLUX_XTABLES_WRITER_OWNER_PID:-}" ] ||
        [ -n "${FLUX_XTABLES_WRITER_OWNER_START_TICKS:-}" ] ||
        [ -n "${FLUX_XTABLES_WRITER_OWNER_BOOT_ID:-}" ]; then
        if ! inherit_shell_xtables_writer_lock; then
            log_error "Inherited networking writer ownership is invalid"
            return 1
        fi
    else
        if ! claim_shell_xtables_writer_lock; then
            log_error "Another networking ownership transition is in progress"
            return 1
        fi
    fi

    trap '_release_networking_writer' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    if [ -e "${NATIVE_XTABLES_LEASE_FILE}" ] || [ -L "${NATIVE_XTABLES_LEASE_FILE}" ]; then
        log_error "Native networking ownership is active; refusing addrsync mutation"
        _release_networking_writer || true
        return 1
    fi
}

_run_mutating_action() {
    local action="${1}"
    local rc=0

    _claim_networking_writer || return 1
    case "${action}" in
    start) start_addrsync || rc=$? ;;
    stop) stop_addrsync || rc=$? ;;
    resync) resync_addrsync || rc=$? ;;
    cleanup) cleanup_addrsync || rc=$? ;;
    *) rc=2 ;;
    esac
    _release_networking_writer || rc=1
    trap - EXIT INT TERM
    return "${rc}"
}

main() {
    local action="${1:-}"

    case "${action}" in
    start | stop | resync | cleanup)
        # The shared child identity covers this mutating controller command.
        # The intentionally long-lived standalone daemon remains outside this
        # phase lifetime until its separate cutover backlog item is completed.
        _run_mutating_action "${action}"
        ;;
    status)
        status_addrsync
        ;;
    *)
        echo "Usage: $0 {start|stop|resync|status|cleanup}"
        exit 1
        ;;
    esac
}

main "$@"
