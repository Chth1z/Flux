+func TestTCPWrapperObservesSegmentedPayloadThenEmitsTerminalAndEOF(t *testing.T) {
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("listen: %v", err)
+	}
+	defer listener.Close()
+	client, err := net.Dial("tcp4", listener.Addr().String())
+	if err != nil {
+		t.Fatalf("dial: %v", err)
+	}
+	defer client.Close()
+	server, err := listener.Accept()
+	if err != nil {
+		t.Fatalf("accept: %v", err)
+	}
+	defer server.Close()
+
+	report := socketPair(t)
+	defer closePair(report)
+	binding := testBinding()
+	binding.requiredFlows = 1 << 0
+	attempt := &reportAttempt{binding: binding, reportFD: report[0], nextFlow: 0, sequence: 1}
+	service := &reportService{active: attempt}
+	activeService.Store(service)
+	defer activeService.Store(nil)
+	wrapped := WrapTProxyTCP(listener, server)
+	if wrapped == server {
+		t.Fatal("active expected TCP flow was not wrapped")
+	}
+	if replaceable, ok := wrapped.(interface{ ReaderReplaceable() bool }); !ok || replaceable.ReaderReplaceable() {
+		t.Fatal("observer read hook may be bypassed")
+	}
+
+	nonce := binding.nonce[:]
+	go func() {
+		_, _ = client.Write(nonce[:7])
+		time.Sleep(10 * time.Millisecond)
+		_, _ = client.Write(nonce[7:])
+		_ = client.(*net.TCPConn).CloseWrite()
+	}()
+	received := make([]byte, len(nonce))
+	if _, err := io.ReadFull(wrapped, received); err != nil {
+		t.Fatalf("read transparent payload: %v", err)
+	}
+	if !bytes.Equal(received, nonce) {
+		t.Fatal("TCP wrapper changed payload bytes")
+	}
+	boundary := make([]byte, 1)
+	if length, err := wrapped.Read(boundary); length != 0 || !errors.Is(err, io.EOF) {
+		t.Fatalf("read transparent payload boundary: length=%d err=%v", length, err)
+	}
+
+	delivery := receiveRecord(t, report[1], tcpReportBytes)
+	if delivery[10] != reportKindTCP || delivery[reportHeaderBytes] != 0 || binary.BigEndian.Uint64(delivery[16:24]) != 1 {
+		t.Fatalf("unexpected TCP report header: %x", delivery[:reportHeaderBytes+1])
+	}
+	terminal := receiveRecord(t, report[1], terminalReportBytes)
+	if terminal[10] != reportKindTerminal || terminal[reportHeaderBytes] != 1 || binary.BigEndian.Uint64(terminal[16:24]) != 2 {
+		t.Fatalf("unexpected terminal report: %x", terminal)
+	}
+	buffer := make([]byte, 1)
+	length, err := unix.Read(report[1], buffer)
+	if err != nil || length != 0 {
+		t.Fatalf("report producer did not close after terminal: length=%d err=%v", length, err)
+	}
+}
