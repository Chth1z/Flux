# ==============================================================================
# [ File Utilities ]
# ==============================================================================

# Get file age in seconds
# Usage: file_age FILE
file_age() {
    local file="${1}"
    [ ! -f "${file}" ] && echo 0 && return 0

    local mtime
    mtime=$(stat -c%Y "${file}" 2>/dev/null) || {
        log_error "stat failed: ${file}"
        return 1
    }
    echo $(($(date +%s) - mtime))
}

# Get file size in bytes
# Usage: file_size FILE
file_size() {
    local file="${1}"
    [ ! -f "${file}" ] && echo 0 && return 0
    stat -c%s "${file}" 2>/dev/null || {
        log_error "stat failed: ${file}"
        return 1
    }
}

# Atomic write to file to prevent corruption
# Usage: atomic_write TARGET_FILE command [args...]
atomic_write() {
    local target_file="${1}"
    shift

    local tmp_file
    tmp_file=$(mktemp "${target_file}.XXXXXX") || return 1

    local rc
    if "$@" >"${tmp_file}"; then
        mv -f "${tmp_file}" "${target_file}"
        return 0
    else
        rc=$?
        rm -f "${tmp_file}"
        log_error "Write failed: ${target_file##*/}"
        return "${rc}"
    fi
}

# Generic cleanup utility
# Usage: trap 'cleanup "Message" "$FILE" "$DIR"' EXIT INT TERM
cleanup() {
    local rc=$?
    local msg="${1}"
    shift

    [ -n "${msg}" ] && log_debug "${msg}"
    for item in "$@"; do
        [ -n "${item}" ] && rm -rf "${item}" 2>/dev/null
    done
    return "${rc}"
}

# ==============================================================================
# [ Network Utilities ]
# ==============================================================================

# Check if string is a valid integer
# Usage: is_int STRING
is_int() {
    case "${1}" in
    '' | *[!0-9]*) return 1 ;;
    esac
    return 0
}

# Check whether a proc-style word list contains an exact line.
# Usage: proc_has_word FILE WORD
proc_has_word() {
    local file="${1}"
    local word="${2}"
    local line

    [ -r "${file}" ] || return 1
    while IFS= read -r line; do
        [ "${line}" = "${word}" ] && return 0
    done <"${file}"
    return 1
}

# Check if a port is listening
# Usage: is_port_listening PORT
is_port_listening() {
    local port="${1}"
    command -v ss >/dev/null 2>&1 || {
        log_error "ss command missing"
        return 1
    }
    ss -Hltn "sport = :${port}" 2>/dev/null | grep -q "."
}

# ==============================================================================
# [ Process Utilities ]
# ==============================================================================

# Read and validate a PID from pid file.
# Usage: read_pid_file PID_FILE [LABEL]
read_pid_file() {
    local pid_file="${1}"
    local label="${2}"
    local pid=""

    [ -f "${pid_file}" ] || return 0

    IFS= read -r pid <"${pid_file}" || {
        log_error "Failed reading ${label} pid file"
        return 1
    }

    [ -z "${pid}" ] && return 0

    is_int "${pid}" || {
        log_error "Invalid ${label} pid: ${pid}"
        return 1
    }

    printf '%s\n' "${pid}"
}

# Check whether a PID is alive.
# Usage: pid_alive PID
pid_alive() {
    local pid="${1}"
    [ -n "${pid}" ] || return 1
    [ -d "/proc/${pid}" ] || kill -0 "${pid}" 2>/dev/null
}

# Verify /proc cmdline contains an expected fragment.
# Usage: pid_matches_cmd PID EXPECTED_FRAGMENT
pid_matches_cmd() {
    local pid="${1}"
    local expected="${2}"

    [ -n "${expected}" ] || return 0
    [ -r "/proc/${pid}/cmdline" ] || return 1

    tr '\0' ' ' <"/proc/${pid}/cmdline" 2>/dev/null | grep -Fq -- "${expected}"
}

# Read Linux process start ticks (field 22 in /proc/PID/stat).
# Usage: process_start_ticks PID
process_start_ticks() {
    local pid="${1}"
    local stat_line=""
    local stat_fields=""
    local start_ticks=""

    [ -r "/proc/${pid}/stat" ] || return 1
    IFS= read -r stat_line <"/proc/${pid}/stat" || return 1
    stat_fields="${stat_line##*) }"
    [ "${stat_fields}" != "${stat_line}" ] || return 1

    set -- ${stat_fields}
    [ "$#" -ge 20 ] || return 1
    start_ticks="${20}"
    is_int "${start_ticks}" || return 1
    printf '%s\n' "${start_ticks}"
}

# Read and validate the current Linux boot identity.
current_boot_id() {
    local boot_id=""

    [ -r "/proc/sys/kernel/random/boot_id" ] || return 1
    IFS= read -r boot_id <"/proc/sys/kernel/random/boot_id" || return 1
    is_canonical_boot_id "${boot_id}" || return 1
    printf '%s\n' "${boot_id}"
}

# Validate one canonical positive decimal integer.
is_canonical_positive_decimal() {
    case "${1}" in
    '' | 0 | 0* | *[!0-9]*) return 1 ;;
    esac
}

is_canonical_process_pid() {
    local pid="${1}"

    is_canonical_positive_decimal "${pid}" || return 1
    [ "${#pid}" -le 10 ] || return 1
    [ "${#pid}" -lt 10 ] || [ "${pid}" -le 4294967295 ]
}

is_canonical_process_start_ticks() {
    local start_ticks="${1}"

    is_canonical_positive_decimal "${start_ticks}" || return 1
    # Linux cannot approach a 20-digit start tick within a real boot lifetime;
    # the bound also avoids shell-integer ambiguity while Rust parses as u64.
    [ "${#start_ticks}" -le 19 ]
}

# Validate the lowercase canonical UUID shape emitted by Linux boot_id.
is_canonical_boot_id() {
    local remaining="${1}"
    local field=""
    local width=""

    for width in 8 4 4 4; do
        field="${remaining%%-*}"
        [ "${field}" != "${remaining}" ] || return 1
        [ "${#field}" -eq "${width}" ] || return 1
        case "${field}" in
        *[!0-9a-f]*) return 1 ;;
        esac
        remaining="${remaining#*-}"
    done
    [ "${#remaining}" -eq 12 ] || return 1
    case "${remaining}" in
    *[!0-9a-f]*) return 1 ;;
    esac
}

# Require the lock directory to contain exactly one regular shell-owner record.
shell_xtables_writer_lock_is_exact() {
    local entry=""
    local count=0

    [ -d "${XTABLES_WRITER_LOCK_DIR}" ] && [ ! -L "${XTABLES_WRITER_LOCK_DIR}" ] || return 1
    for entry in \
        "${XTABLES_WRITER_LOCK_DIR}"/* \
        "${XTABLES_WRITER_LOCK_DIR}"/.[!.]* \
        "${XTABLES_WRITER_LOCK_DIR}"/..?*; do
        [ -e "${entry}" ] || [ -L "${entry}" ] || continue
        count=$((count + 1))
        [ "${entry}" = "${XTABLES_WRITER_SHELL_OWNER_FILE}" ] || return 1
    done
    [ "${count}" -eq 1 ]
}

# Read one canonical v2 shell xtables-writer owner record.
# Format: magic parent-pid parent-start child-pid-or-0 child-start-or-0 boot-id
read_shell_xtables_writer_owner() {
    local encoded=""
    local trailing=""
    local magic=""
    local parent_pid=""
    local parent_start=""
    local child_pid=""
    local child_start=""
    local boot_id=""
    local extra=""
    local canonical=""

    shell_xtables_writer_lock_is_exact || return 1
    [ -f "${XTABLES_WRITER_SHELL_OWNER_FILE}" ] &&
        [ ! -L "${XTABLES_WRITER_SHELL_OWNER_FILE}" ] || return 1
    {
        IFS= read -r encoded || return 1
        if IFS= read -r trailing; then
            return 1
        fi
    } <"${XTABLES_WRITER_SHELL_OWNER_FILE}"
    IFS=' ' read -r \
        magic parent_pid parent_start child_pid child_start boot_id extra <<EOF
${encoded}
EOF
    [ -z "${extra}" ] || return 1
    [ "${magic}" = "${XTABLES_WRITER_SHELL_OWNER_MAGIC}" ] || return 1
    is_canonical_process_pid "${parent_pid}" || return 1
    is_canonical_process_start_ticks "${parent_start}" || return 1
    case "${child_pid}:${child_start}" in
    0:0) ;;
    0:* | *:0) return 1 ;;
    *)
        is_canonical_process_pid "${child_pid}" || return 1
        is_canonical_process_start_ticks "${child_start}" || return 1
        ;;
    esac
    is_canonical_boot_id "${boot_id}" || return 1
    canonical="${magic} ${parent_pid} ${parent_start} ${child_pid} ${child_start} ${boot_id}"
    [ "${encoded}" = "${canonical}" ] || return 1
    printf '%s\n' "${canonical}"
}

_write_shell_xtables_writer_owner() {
    local parent_pid="${1}"
    local parent_start="${2}"
    local child_pid="${3}"
    local child_start="${4}"
    local boot_id="${5}"

    atomic_write "${XTABLES_WRITER_SHELL_OWNER_FILE}" \
        printf '%s %s %s %s %s %s\n' \
        "${XTABLES_WRITER_SHELL_OWNER_MAGIC}" \
        "${parent_pid}" "${parent_start}" \
        "${child_pid}" "${child_start}" "${boot_id}" || return 1
    chmod 0600 "${XTABLES_WRITER_SHELL_OWNER_FILE}" 2>/dev/null
}

shell_xtables_writer_process_is_live() {
    local pid="${1}"
    local start_ticks="${2}"
    local record_boot="${3}"
    local current_boot="${4}"
    local observed_start=""
    local stat_file="/proc/${pid}/stat"

    [ "${record_boot}" = "${current_boot}" ] || return 1
    [ -e "${stat_file}" ] || return 1
    [ -r "${stat_file}" ] || return 2
    if observed_start=$(process_start_ticks "${pid}"); then
        [ "${observed_start}" = "${start_ticks}" ]
        return $?
    fi
    [ -e "${stat_file}" ] || return 1
    return 2
}

shell_xtables_writer_parent_is_live() {
    local record="${1}"
    local current_boot="${2}"

    set -- ${record}
    [ "$#" -eq 6 ] || return 1
    shell_xtables_writer_process_is_live "${2}" "${3}" "${6}" "${current_boot}"
}

shell_xtables_writer_child_is_live() {
    local record="${1}"
    local current_boot="${2}"

    set -- ${record}
    [ "$#" -eq 6 ] || return 1
    [ "${4}" != "0" ] || return 1
    shell_xtables_writer_process_is_live "${4}" "${5}" "${6}" "${current_boot}"
}

# A v2 shell record remains busy while either authenticated participant is live.
shell_xtables_writer_owner_is_live() {
    local record="${1}"
    local current_boot="${2:-}"
    local parent_status=0
    local child_status=0

    [ -n "${current_boot}" ] || current_boot=$(current_boot_id) || return 2
    shell_xtables_writer_parent_is_live "${record}" "${current_boot}" || parent_status=$?
    [ "${parent_status}" -ne 0 ] || return 0
    shell_xtables_writer_child_is_live "${record}" "${current_boot}" || child_status=$?
    [ "${child_status}" -ne 0 ] || return 0
    if [ "${parent_status}" -eq 2 ] || [ "${child_status}" -eq 2 ]; then
        return 2
    fi
    return 1
}

retire_stale_shell_xtables_writer_lock() {
    local record=""
    local revalidated=""
    local current_boot=""
    local owner_status=0

    shell_xtables_writer_lock_is_exact || return 1
    record=$(read_shell_xtables_writer_owner) || return 1
    current_boot=$(current_boot_id) || return 1
    shell_xtables_writer_owner_is_live "${record}" "${current_boot}" || owner_status=$?
    [ "${owner_status}" -eq 1 ] || return 1
    shell_xtables_writer_lock_is_exact || return 1
    revalidated=$(read_shell_xtables_writer_owner) || return 1
    [ "${revalidated}" = "${record}" ] || return 1
    rm -f "${XTABLES_WRITER_SHELL_OWNER_FILE}" 2>/dev/null || return 1
    rmdir "${XTABLES_WRITER_LOCK_DIR}" 2>/dev/null || return 1
}

reset_shell_xtables_writer_lock_state() {
    unset \
        XTABLES_WRITER_LOCK_OWNED \
        XTABLES_WRITER_OWNER_PID \
        XTABLES_WRITER_OWNER_START_TICKS \
        XTABLES_WRITER_OWNER_BOOT_ID \
        XTABLES_WRITER_PARENT_PID \
        XTABLES_WRITER_PARENT_START_TICKS \
        XTABLES_WRITER_PARENT_BOOT_ID \
        XTABLES_WRITER_CHILD_PID \
        XTABLES_WRITER_CHILD_START_TICKS 2>/dev/null || return 1
    XTABLES_WRITER_LOCK_OWNED=0
    XTABLES_WRITER_OWNER_PID=""
    XTABLES_WRITER_OWNER_START_TICKS=""
    XTABLES_WRITER_OWNER_BOOT_ID=""
    XTABLES_WRITER_PARENT_PID=""
    XTABLES_WRITER_PARENT_START_TICKS=""
    XTABLES_WRITER_PARENT_BOOT_ID=""
    XTABLES_WRITER_CHILD_PID=""
    XTABLES_WRITER_CHILD_START_TICKS=""
}

claim_shell_xtables_writer_lock() {
    local attempt=0
    local owner_start=""
    local owner_boot=""

    reset_shell_xtables_writer_lock_state || return 1
    [ -d "${RUN_DIR}" ] || mkdir -p "${RUN_DIR}" || return 1

    while ! mkdir "${XTABLES_WRITER_LOCK_DIR}" 2>/dev/null; do
        [ "${attempt}" -eq 0 ] || return 1
        retire_stale_shell_xtables_writer_lock || return 1
        attempt=$((attempt + 1))
    done

    owner_start=$(process_start_ticks "$$") || {
        rmdir "${XTABLES_WRITER_LOCK_DIR}" 2>/dev/null || true
        return 1
    }
    owner_boot=$(current_boot_id) || {
        rmdir "${XTABLES_WRITER_LOCK_DIR}" 2>/dev/null || true
        return 1
    }
    if ! _write_shell_xtables_writer_owner "$$" "${owner_start}" 0 0 "${owner_boot}"; then
        rm -f "${XTABLES_WRITER_SHELL_OWNER_FILE}" 2>/dev/null || true
        rmdir "${XTABLES_WRITER_LOCK_DIR}" 2>/dev/null || true
        return 1
    fi

    XTABLES_WRITER_LOCK_OWNED=1
    XTABLES_WRITER_OWNER_PID="$$"
    XTABLES_WRITER_OWNER_START_TICKS="${owner_start}"
    XTABLES_WRITER_OWNER_BOOT_ID="${owner_boot}"
    XTABLES_WRITER_PARENT_PID="$$"
    XTABLES_WRITER_PARENT_START_TICKS="${owner_start}"
    XTABLES_WRITER_PARENT_BOOT_ID="${owner_boot}"
}

revalidate_shell_xtables_writer_parent_lock() {
    local observed=""
    local revalidated=""
    local current_boot=""
    local current_start=""
    local child_status=0

    [ "${XTABLES_WRITER_LOCK_OWNED:-0}" = "1" ] || return 1
    current_boot=$(current_boot_id) || return 1
    current_start=$(process_start_ticks "$$") || return 1
    [ "${XTABLES_WRITER_OWNER_PID:-}" = "$$" ] || return 1
    [ "${XTABLES_WRITER_OWNER_START_TICKS:-}" = "${current_start}" ] || return 1
    [ "${XTABLES_WRITER_OWNER_BOOT_ID:-}" = "${current_boot}" ] || return 1
    [ "${XTABLES_WRITER_PARENT_PID:-}" = "$$" ] || return 1
    [ "${XTABLES_WRITER_PARENT_START_TICKS:-}" = "${current_start}" ] || return 1
    [ "${XTABLES_WRITER_PARENT_BOOT_ID:-}" = "${current_boot}" ] || return 1
    [ -z "${XTABLES_WRITER_CHILD_PID:-}" ] || return 1
    [ -z "${XTABLES_WRITER_CHILD_START_TICKS:-}" ] || return 1

    observed=$(read_shell_xtables_writer_owner) || return 1
    set -- ${observed}
    [ "${2}" = "$$" ] || return 1
    [ "${3}" = "${current_start}" ] || return 1
    [ "${6}" = "${current_boot}" ] || return 1
    if [ "${4}" != "0" ]; then
        shell_xtables_writer_process_is_live \
            "${4}" "${5}" "${6}" "${current_boot}" || child_status=$?
        [ "${child_status}" -eq 1 ] || return 1
    fi
    revalidated=$(read_shell_xtables_writer_owner) || return 1
    [ "${revalidated}" = "${observed}" ]
}

inherit_shell_xtables_writer_lock() {
    local observed=""
    local revalidated=""
    local current_boot=""
    local child_start=""
    local child_status=0

    is_canonical_process_pid "${FLUX_XTABLES_WRITER_OWNER_PID:-}" || return 1
    is_canonical_process_start_ticks "${FLUX_XTABLES_WRITER_OWNER_START_TICKS:-}" || return 1
    is_canonical_boot_id "${FLUX_XTABLES_WRITER_OWNER_BOOT_ID:-}" || return 1
    [ "${PPID}" = "${FLUX_XTABLES_WRITER_OWNER_PID}" ] || return 1
    current_boot=$(current_boot_id) || return 1
    [ "${current_boot}" = "${FLUX_XTABLES_WRITER_OWNER_BOOT_ID}" ] || return 1
    shell_xtables_writer_process_is_live \
        "${FLUX_XTABLES_WRITER_OWNER_PID}" \
        "${FLUX_XTABLES_WRITER_OWNER_START_TICKS}" \
        "${FLUX_XTABLES_WRITER_OWNER_BOOT_ID}" \
        "${current_boot}" || return 1
    observed=$(read_shell_xtables_writer_owner) || return 1
    set -- ${observed}
    [ "${2}" = "${FLUX_XTABLES_WRITER_OWNER_PID}" ] || return 1
    [ "${3}" = "${FLUX_XTABLES_WRITER_OWNER_START_TICKS}" ] || return 1
    [ "${6}" = "${FLUX_XTABLES_WRITER_OWNER_BOOT_ID}" ] || return 1
    if [ "${4}" != "0" ]; then
        shell_xtables_writer_process_is_live \
            "${4}" "${5}" "${6}" "${current_boot}" || child_status=$?
        [ "${child_status}" -eq 1 ] || return 1
    fi

    child_start=$(process_start_ticks "$$") || return 1
    shell_xtables_writer_lock_is_exact || return 1
    revalidated=$(read_shell_xtables_writer_owner) || return 1
    [ "${revalidated}" = "${observed}" ] || return 1
    _write_shell_xtables_writer_owner \
        "${FLUX_XTABLES_WRITER_OWNER_PID}" \
        "${FLUX_XTABLES_WRITER_OWNER_START_TICKS}" \
        "$$" "${child_start}" "${current_boot}" || return 1

    XTABLES_WRITER_LOCK_OWNED=2
    XTABLES_WRITER_OWNER_PID="${FLUX_XTABLES_WRITER_OWNER_PID}"
    XTABLES_WRITER_OWNER_START_TICKS="${FLUX_XTABLES_WRITER_OWNER_START_TICKS}"
    XTABLES_WRITER_OWNER_BOOT_ID="${current_boot}"
    XTABLES_WRITER_PARENT_PID="${FLUX_XTABLES_WRITER_OWNER_PID}"
    XTABLES_WRITER_PARENT_START_TICKS="${FLUX_XTABLES_WRITER_OWNER_START_TICKS}"
    XTABLES_WRITER_PARENT_BOOT_ID="${current_boot}"
    XTABLES_WRITER_CHILD_PID="$$"
    XTABLES_WRITER_CHILD_START_TICKS="${child_start}"
}

release_shell_xtables_writer_lock() {
    local observed=""
    local revalidated=""
    local expected=""
    local current_boot=""
    local current_start=""
    local participant_status=0

    [ "${XTABLES_WRITER_LOCK_OWNED:-0}" != "0" ] || return 0
    case "${XTABLES_WRITER_LOCK_OWNED}" in
    1 | 2) ;;
    *) return 1 ;;
    esac
    current_boot=$(current_boot_id) || return 1
    current_start=$(process_start_ticks "$$") || return 1
    observed=$(read_shell_xtables_writer_owner) || return 1

    if [ "${XTABLES_WRITER_LOCK_OWNED}" = "2" ]; then
        [ "${XTABLES_WRITER_CHILD_PID:-}" = "$$" ] || return 1
        [ "${XTABLES_WRITER_CHILD_START_TICKS:-}" = "${current_start}" ] || return 1
        [ "${XTABLES_WRITER_OWNER_PID:-}" = "${XTABLES_WRITER_PARENT_PID:-}" ] || return 1
        [ "${XTABLES_WRITER_OWNER_START_TICKS:-}" = "${XTABLES_WRITER_PARENT_START_TICKS:-}" ] || return 1
        [ "${XTABLES_WRITER_OWNER_BOOT_ID:-}" = "${current_boot}" ] || return 1
        [ "${XTABLES_WRITER_PARENT_BOOT_ID:-}" = "${current_boot}" ] || return 1
        expected="${XTABLES_WRITER_SHELL_OWNER_MAGIC} ${XTABLES_WRITER_PARENT_PID} ${XTABLES_WRITER_PARENT_START_TICKS} ${XTABLES_WRITER_CHILD_PID} ${XTABLES_WRITER_CHILD_START_TICKS} ${XTABLES_WRITER_PARENT_BOOT_ID}"
        [ "${observed}" = "${expected}" ] || return 1
        shell_xtables_writer_process_is_live \
            "${XTABLES_WRITER_PARENT_PID}" \
            "${XTABLES_WRITER_PARENT_START_TICKS}" \
            "${XTABLES_WRITER_PARENT_BOOT_ID}" \
            "${current_boot}" || participant_status=$?
        if [ "${participant_status}" -eq 0 ]; then
            shell_xtables_writer_lock_is_exact || return 1
            revalidated=$(read_shell_xtables_writer_owner) || return 1
            [ "${revalidated}" = "${observed}" ] || return 1
            _write_shell_xtables_writer_owner \
                "${XTABLES_WRITER_PARENT_PID}" \
                "${XTABLES_WRITER_PARENT_START_TICKS}" \
                0 0 "${XTABLES_WRITER_PARENT_BOOT_ID}" || return 1
            reset_shell_xtables_writer_lock_state
            return 0
        fi
        [ "${participant_status}" -eq 1 ] || return 1
    else
        [ "${XTABLES_WRITER_OWNER_PID:-}" = "$$" ] || return 1
        [ "${XTABLES_WRITER_OWNER_START_TICKS:-}" = "${current_start}" ] || return 1
        [ "${XTABLES_WRITER_OWNER_BOOT_ID:-}" = "${current_boot}" ] || return 1
        [ "${XTABLES_WRITER_PARENT_PID:-}" = "$$" ] || return 1
        [ "${XTABLES_WRITER_PARENT_START_TICKS:-}" = "${current_start}" ] || return 1
        [ "${XTABLES_WRITER_PARENT_BOOT_ID:-}" = "${current_boot}" ] || return 1
        [ -z "${XTABLES_WRITER_CHILD_PID:-}" ] || return 1
        [ -z "${XTABLES_WRITER_CHILD_START_TICKS:-}" ] || return 1
        set -- ${observed}
        [ "${2}" = "$$" ] || return 1
        [ "${3}" = "${current_start}" ] || return 1
        [ "${6}" = "${current_boot}" ] || return 1
        if [ "${4}" != "0" ]; then
            participant_status=0
            shell_xtables_writer_process_is_live \
                "${4}" "${5}" "${6}" "${current_boot}" || participant_status=$?
            [ "${participant_status}" -eq 1 ] || return 1
        fi
    fi

    shell_xtables_writer_lock_is_exact || return 1
    revalidated=$(read_shell_xtables_writer_owner) || return 1
    [ "${revalidated}" = "${observed}" ] || return 1
    rm -f "${XTABLES_WRITER_SHELL_OWNER_FILE}" 2>/dev/null || return 1
    rmdir "${XTABLES_WRITER_LOCK_DIR}" 2>/dev/null || return 1
    reset_shell_xtables_writer_lock_state
}

# Wait until pid enters a target state.
# Usage: wait_pid_state PID TIMEOUT_SEC alive|dead
wait_pid_state() {
    local pid="${1}"
    local timeout="${2}"
    local target="${3}"
    local count=0

    while [ "${count}" -lt "${timeout}" ]; do
        if [ "${target}" = "alive" ]; then
            pid_alive "${pid}" && return 0
        else
            pid_alive "${pid}" || return 0
        fi
        sleep 1
        count=$((count + 1))
    done
    return 1
}

# Terminate a process gracefully, then force-kill if needed.
# Usage: terminate_pid PID TIMEOUT_SEC LABEL
terminate_pid() {
    local pid="${1}"
    local timeout="${2}"
    local label="${3}"

    pid_alive "${pid}" || return 0

    kill "${pid}" 2>/dev/null || true
    wait_pid_state "${pid}" "${timeout}" dead && return 0

    log_warn "${label} process hung, force killing..."
    kill -9 "${pid}" 2>/dev/null || true
    wait_pid_state "${pid}" 2 dead || true

    pid_alive "${pid}" && return 1
    return 0
}

# Persist PID atomically.
# Usage: write_pid_file PID_FILE PID
write_pid_file() {
    local pid_file="${1}"
    local pid="${2}"

    atomic_write "${pid_file}" printf '%s' "${pid}"
}

# Get a validated daemon PID matching the given command
# Usage: get_valid_daemon_pid PID_FILE BINARY_MATCH LABEL
get_valid_daemon_pid() {
    local pid_file="${1}"
    local cmd_match="${2}"
    local label="${3}"
    local pid=""

    if pid=$(read_pid_file "${pid_file}" "${label}"); then
        if [ -n "${pid}" ] && pid_alive "${pid}"; then
            if pid_matches_cmd "${pid}" "${cmd_match}"; then
                printf '%s\n' "${pid}"
                return 0
            else
                log_warn "${label} pid mismatch, skipping kill (pid=${pid})"
            fi
        fi
    fi
    rm -f "${pid_file}"
    return 1
}

# ==============================================================================
# [ String Utilities ]
# ==============================================================================

# Retry a command with exponential backoff
# Usage: retry MAX_ATTEMPTS command [args...]
retry() {
    local max="${1}"
    shift

    local n=0
    local wait=1
    while [ "${n}" -lt "${max}" ]; do
        "$@" && return 0
        n=$((n + 1))
        [ "${n}" -lt "${max}" ] && {
            log_warn "Retry ${n}/${max}..."
            sleep "${wait}"
            wait=$((wait * 2))
            [ "${wait}" -gt 16 ] && wait=16
        }
    done
    return 1
}

# Check if content is base64 encoded
# Usage: is_base64 FILE
is_base64() {
    local file="${1}"
    local s
    s=$(head -c 512 "${file}" 2>/dev/null)

    [ -z "${s}" ] && return 1
    case "${s}" in
    "https://"* | "http://"* | "ss://"* | "vmess://"* | "vless://"* | "trojan://"* | "hysteria2://"* | "tuic://"* | "{"* | "#"*)
        return 1
        ;;
    *[!A-Za-z0-9+/=[:space:]]*) return 1 ;;
    *) return 0 ;;
    esac
}

# ==============================================================================
# [ Task Utilities ]
# ==============================================================================

# Standardized task runner with logging and status reporting
# Usage: run [OPTIONS] "Name" command [args...]
# Options:
#   -v, --verbose  Show OK message on success (default: silent)
#   -i, --ignore   Do not log error on failure
run() {
    local verbose=false
    local ignore_err=false

    while [ "$#" -gt 0 ]; do
        case "${1}" in
        --)
            shift
            break
            ;;
        -v | --verbose)
            verbose=true
            shift
            ;;
        -i | --ignore)
            ignore_err=true
            shift
            ;;
        -[vi]*)
            local opts="${1#-}"
            case "${opts}" in
            *v*) verbose=true ;;
            esac
            case "${opts}" in
            *i*) ignore_err=true ;;
            esac
            shift
            ;;
        -*)
            log_error "run: unknown option '${1}'"
            return 2
            ;;
        *)
            break
            ;;
        esac
    done

    [ "$#" -ge 2 ] || {
        log_error "run: insufficient arguments"
        return 2
    }

    local name="${1}"
    shift

    if "$@"; then
        [ "${verbose}" = true ] && log_info "${name}: OK"
        return 0
    else
        local _rc=$?
        [ "${ignore_err}" = false ] && log_error "${name}: FAILED (rc=${_rc})"
        return "${_rc}"
    fi
}

# Wait for multiple PIDs and return 0 only if ALL succeeded
# Usage: wait_pids [pids...]
wait_pids() {
    local rc=0
    for pid in "$@"; do
        wait "${pid}" || rc=$?
    done
    return "${rc}"
}

# Wait for multiple PIDs with timeout and Fail-Fast check
# Usage: wait_pids_timeout TIMEOUT PID...
wait_pids_timeout() {
    local timeout="${1}"
    shift
    local pids="$@"
    local count=0

    while [ "${count}" -lt "${timeout}" ]; do
        # 1. Check process status
        local running=0
        for pid in ${pids}; do
            if kill -0 "${pid}" 2>/dev/null; then
                running=1
                break
            fi
        done

        if [ "${running}" -eq 0 ]; then
            local rc=0
            for pid in ${pids}; do
                wait "${pid}" || rc=1
            done
            return "${rc}"
        fi

        sleep 1
        count=$((count + 1))
    done

    log_error "Timeout waiting for background tasks"
    return 1
}

# ==============================================================================
# [ Configuration Loading ]
# ==============================================================================

load_config() {
    if [ -f "${EVENT_CACHE_OK}" ] && [ -f "${CACHE_CONFIG_FILE}" ]; then
        set -a
        . "${CACHE_CONFIG_FILE}"
        set +a
        return 0
    fi

    [ -f "${SETTINGS_FILE}" ] || {
        log_error "No configuration found"
        return 1
    }
    [ -f "${CONFIG_SCRIPT}" ] || {
        log_error "Config script missing"
        return 1
    }

    # Parse+validate settings via config module instead of sourcing raw shell.
    . "${CONFIG_SCRIPT}"

    local tmp_cfg
    local tmp_dir="${RUN_DIR}"
    [ -d "${tmp_dir}" ] || tmp_dir="${FLUX_DIR}"
    [ -d "${tmp_dir}" ] || tmp_dir="/data/local/tmp"

    tmp_cfg=$(mktemp "${tmp_dir}/loadcfg.XXXXXX") || {
        log_error "Failed to create temporary config file"
        return 1
    }

    if { _process_settings && _detect_kernel; } >"${tmp_cfg}"; then
        [ -d "${CACHE_DIR}" ] && awk '/^KFEAT_/ { print }' "${tmp_cfg}" >"${CACHE_KERNEL_CAPS_FILE}" 2>/dev/null || true
        set -a
        . "${tmp_cfg}"
        set +a
        rm -f "${tmp_cfg}"
        return 0
    fi

    rm -f "${tmp_cfg}"
    log_error "Failed to load validated settings"
    return 1
}
