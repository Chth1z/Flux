#!/system/bin/sh

# ==============================================================================
# [ Flux Inotify Event Bridge ]
# Description: Forwards raw inotifyd facts to the fluxd control plane.
# ==============================================================================

set -eu
[ -n "${BASH_VERSION:-}" ] && set -o pipefail

_script_path="${0}"
case "${_script_path}" in
/*) ;;
*) _script_path="${PWD}/${_script_path}" ;;
esac
readonly SCRIPT_DIR="${_script_path%/*}"

. "${SCRIPT_DIR}/lib"
. "${SCRIPT_DIR}/log"

readonly LOG_COMPONENT="Evt"

main() {
    [ "$#" -eq 3 ] || {
        log_error "Expected inotifyd facts: EVENT_TYPE WATCHED_PATH EVENT_NAME"
        return 2
    }

    [ -x "${FLUXD_BIN}" ] || {
        log_error "fluxd binary missing or not executable: ${FLUXD_BIN}"
        return 127
    }

    # Keep the inotifyd argv shape intact. Event-to-intent policy belongs to
    # fluxd; this Adapter must not infer lifecycle actions or mutate state.
    exec "${FLUXD_BIN}" event "$@"
}

main "$@"
