+func TestExpectedPayloadDerivesCanonicalEchoAndDNSIdentities(t *testing.T) {
+	nonce := [32]byte{0x5a}
+	echo, echoIdentity := expectedPayload(0, nonce)
+	if !bytes.Equal(echo, nonce[:]) || echoIdentity.kind != payloadKindEcho || echoIdentity.wireLength != 32 {
+		t.Fatalf("unexpected echo identity: bytes=%x identity=%+v", echo, echoIdentity)
+	}
+
+	dnsUDP, udpIdentity := expectedPayload(2, nonce)
+	if len(dnsUDP) != 99 || udpIdentity.kind != payloadKindDNS || udpIdentity.wireLength != 99 || udpIdentity.tcpLength != 0 {
+		t.Fatalf("unexpected UDP DNS identity: length=%d identity=%+v", len(dnsUDP), udpIdentity)
+	}
+	if hex.EncodeToString(dnsUDP) != "c8970100000100000000000002663220356130303030303030303030303030303030303030303030303030303030303020303030303030303030303030303030303030303030303030303030303030303004666c757807696e76616c69640000010001" ||
+		hex.EncodeToString(udpIdentity.wireDigest[:]) != "58fbbb2421f3f36bab462bce83ebb4cfa1678fa89848f3da43172900a38f432e" ||
+		hex.EncodeToString(udpIdentity.questionDigest[:]) != "c897bf07aadfc963fe73ead878b0d49f782901f0148e330fb1c682e51903adaf" ||
+		udpIdentity.transactionID != 0xc897 {
+		t.Fatal("UDP DNS identity differs from the Rust cross-language golden vector")
+	}
+	if binary.BigEndian.Uint16(dnsUDP[:2]) != udpIdentity.transactionID || binary.BigEndian.Uint16(dnsUDP[4:6]) != 1 {
+		t.Fatal("UDP DNS query header is not canonical")
+	}
+
+	dnsTCP, tcpIdentity := expectedPayload(3, nonce)
+	if len(dnsTCP) != 101 || binary.BigEndian.Uint16(dnsTCP[:2]) != 99 || sha256.Sum256(dnsTCP[2:]) != tcpIdentity.wireDigest || tcpIdentity.tcpLength != 99 {
+		t.Fatalf("unexpected TCP DNS identity: length=%d identity=%+v", len(dnsTCP), tcpIdentity)
+	}
+}
