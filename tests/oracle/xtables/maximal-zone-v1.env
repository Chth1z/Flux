# Exact cache-input contract for the bounded legacy restore oracle profile.
# It fixes one high-coverage cache-input combination across many scripts/rules
# branches; mutually exclusive and runtime-detected restore shapes remain outside it.
PROXY_MODE='tproxy'
PROXY_PORT='1536'
IPV4_MARK='0x14'
IPV6_MARK='0x19'
BYPASS_MARK='0x11'
MARK_MASK='0xff'

KFEAT_OWNER='1'
KFEAT_MARK='1'
KFEAT_CONNTRACK='1'
KFEAT_SOCKET='1'
KFEAT_SOCKET_TCP='1'
KFEAT_SOCKET_UDP='0'
KFEAT_IPV6_NAT='1'

CORE_USER='1000'
CORE_GROUP='1000'
ROUTING_MARK=''
APP_PROXY_MODE='2'
APP_LIST='com.example.alpha com.example.beta'
APP_USER_SCOPE='list'
APP_USER_LIST='10 2 10'
PACKAGES_LIST="${WORKSPACE}/tests/oracle/xtables/packages.list"

MOBILE_INTERFACE='rmnet_data+'
WIFI_INTERFACE='wlan0'
HOTSPOT_INTERFACE='wlan2'
USB_INTERFACE='rndis+'
PROXY_MOBILE='1'
PROXY_WIFI='0'
PROXY_HOTSPOT='1'
PROXY_USB='0'
EXCLUDE_INTERFACES='wlan+ rmnet+ wlan+'

PERFORMANCE_MODE='1'
MSS_CLAMP_ENABLE='1'
FAKEIP_V4_RANGE='198.18.0.0/15'
FAKEIP_V6_RANGE='fc00::/18'
