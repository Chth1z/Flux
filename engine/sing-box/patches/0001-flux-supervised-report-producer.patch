+func TestParseHandoffAcceptsOnlyCanonicalExactEngineFrame(t *testing.T) {
+	frame := canonicalHandoffFrame(41, 73)
+	parsed, err := parseHandoff(frame, 41, 73)
+	if err != nil {
+		t.Fatalf("parse canonical handoff: %v", err)
+	}
+	if parsed.generation != 9 || parsed.requiredFlows != dualStackFlowMask || !bytes.Equal(parsed.nonce[:], bytes.Repeat([]byte{0x33}, 32)) {
+		t.Fatalf("unexpected parsed handoff: %+v", parsed)
+	}
+
+	mutations := map[string]func([]byte){
+		"magic":              func(value []byte) { value[0] ^= 1 },
+		"schema":             func(value []byte) { value[9]++ },
+		"flags":              func(value []byte) { value[11] = 1 },
+		"frame length":       func(value []byte) { value[13]-- },
+		"request schema":     func(value []byte) { value[17]++ },
+		"families":           func(value []byte) { value[20] = ipv6FamilyFlag },
+		"flow mask":          func(value []byte) { value[21] &^= 1 },
+		"backend":            func(value []byte) { value[22]++ },
+		"prefix reserved":    func(value []byte) { value[23] = 1 },
+		"generation":         func(value []byte) { clear(value[24:28]) },
+		"engine pid":         func(value []byte) { value[31]++ },
+		"engine start ticks": func(value []byte) { value[39]++ },
+		"snapshot revision":  func(value []byte) { clear(value[40:48]) },
+		"suffix reserved":    func(value []byte) { value[159] = 1 },
+	}
+	for name, mutate := range mutations {
+		t.Run(name, func(t *testing.T) {
+			candidate := append([]byte(nil), frame...)
+			mutate(candidate)
+			if _, err := parseHandoff(candidate, 41, 73); err == nil {
+				t.Fatal("mutated handoff was accepted")
+			}
+		})
+	}
+}
