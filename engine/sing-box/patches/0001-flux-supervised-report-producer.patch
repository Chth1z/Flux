+func TestStartOwnsOneAttemptRejectsOverlapAndAcceptsRetiredSuccessor(t *testing.T) {
+	if activeService.Load() != nil {
+		t.Fatal("report service was already active")
+	}
+	control := socketPair(t)
+	flags, err := unix.FcntlInt(uintptr(control[1]), unix.F_GETFD, 0)
+	if err != nil {
+		t.Fatalf("inspect inherited control descriptor: %v", err)
+	}
+	if _, err := unix.FcntlInt(uintptr(control[1]), unix.F_SETFD, flags&^unix.FD_CLOEXEC); err != nil {
+		t.Fatalf("admit inherited control descriptor: %v", err)
+	}
+	t.Setenv(launchControlFDEnvironment, strconv.Itoa(control[1]))
+	if err := Start(); err != nil {
+		t.Fatalf("start report service: %v", err)
+	}
+	if _, exists := os.LookupEnv(launchControlFDEnvironment); exists {
+		t.Fatal("Start retained the descriptor environment")
+	}
+
+	first := socketPair(t)
+	sendHandoff(t, control[0], first[0])
+	_ = unix.Close(first[0])
+	requireEndpointRetained(t, first[1])
+
+	overlap := socketPair(t)
+	sendHandoff(t, control[0], overlap[0])
+	_ = unix.Close(overlap[0])
+	requireEOF(t, overlap[1])
+	_ = unix.Close(overlap[1])
+
+	_ = unix.Close(first[1])
+	successor := socketPair(t)
+	sendHandoff(t, control[0], successor[0])
+	_ = unix.Close(successor[0])
+	requireEndpointRetained(t, successor[1])
+
+	_ = unix.Close(control[0])
+	requireEOF(t, successor[1])
+	_ = unix.Close(successor[1])
+	activeService.Store(nil)
+}
