+	pair := socketPair(t)
+	defer closePair(pair)
+	flags, err := unix.FcntlInt(uintptr(pair[0]), unix.F_GETFD, 0)
+	if err != nil {
+		t.Fatalf("inspect descriptor flags: %v", err)
+	}
+	if _, err := unix.FcntlInt(uintptr(pair[0]), unix.F_SETFD, flags&^unix.FD_CLOEXEC); err != nil {
+		t.Fatalf("clear close-on-exec: %v", err)
+	}
+	if err := restoreCloseOnExec(pair[0]); err != nil {
+		t.Fatalf("restore close-on-exec: %v", err)
+	}
+	readback, err := unix.FcntlInt(uintptr(pair[0]), unix.F_GETFD, 0)
+	if err != nil || readback&unix.FD_CLOEXEC == 0 {
+		t.Fatalf("close-on-exec readback: flags=%d err=%v", readback, err)
+	}
+	closed := pair[1]
+	_ = unix.Close(closed)
+	pair[1] = -1
+	if err := restoreCloseOnExec(closed); err == nil {
+		t.Fatal("closed descriptor passed close-on-exec restoration")
+	}
+}
+
+func TestNonblockingFullQueueAccountsLossWithoutWaiting(t *testing.T) {
+	report := socketPair(t)
+	defer closePair(report)
+	if err := unix.SetsockoptInt(report[0], unix.SOL_SOCKET, unix.SO_SNDBUF, 1024); err != nil {
+		t.Fatalf("shrink send buffer: %v", err)
+	}
+	fill := make([]byte, tcpReportBytes)
+	for {
+		_, err := unix.SendmsgN(report[0], fill, nil, nil, unix.MSG_DONTWAIT|unix.MSG_NOSIGNAL)
+		if errors.Is(err, unix.EAGAIN) || errors.Is(err, unix.EWOULDBLOCK) {
+			break
+		}
+		if err != nil {
+			t.Fatalf("fill report queue: %v", err)
+		}
+	}
+	attempt := &reportAttempt{binding: testBinding(), reportFD: report[0], nextFlow: 0, sequence: 1}
+	service := &reportService{active: attempt}
+	started := time.Now()
+	service.mu.Lock()
+	service.sendLocked(attempt, fill)
+	service.mu.Unlock()
+	if elapsed := time.Since(started); elapsed > 100*time.Millisecond {
+		t.Fatalf("nonblocking report send took %s", elapsed)
+	}
+	if attempt.cumulativeLoss != 1 || service.active != attempt {
+		t.Fatalf("queue loss was not retained: loss=%d active=%p", attempt.cumulativeLoss, service.active)
+	}
+}
+
+func canonicalHandoffFrame(pid uint32, startTicks uint64) []byte {
+	frame := make([]byte, handoffBytes)
+	copy(frame[0:8], handoffMagic[:])
+	binary.BigEndian.PutUint16(frame[8:10], handoffSchema)
+	frame[10] = handoffAttemptKind
+	binary.BigEndian.PutUint16(frame[12:14], handoffBytes)
+	binary.BigEndian.PutUint16(frame[14:16], handoffBytes)
+	binary.BigEndian.PutUint16(frame[16:18], requestSchema)
+	binary.BigEndian.PutUint16(frame[18:20], reportSchema)
+	frame[20] = ipv4FamilyFlag | ipv6FamilyFlag
+	frame[21] = dualStackFlowMask
+	frame[22] = tproxyBackend
+	binary.BigEndian.PutUint32(frame[24:28], 9)
+	binary.BigEndian.PutUint32(frame[28:32], pid)
+	binary.BigEndian.PutUint64(frame[32:40], startTicks)
+	binary.BigEndian.PutUint64(frame[40:48], 11)
+	copy(frame[48:80], bytes.Repeat([]byte{0x11}, 32))
+	copy(frame[80:112], bytes.Repeat([]byte{0x22}, 32))
+	copy(frame[112:144], bytes.Repeat([]byte{0x33}, 32))
+	return frame
+}
+
+func testBinding() handoff {
+	frame := canonicalHandoffFrame(uint32(os.Getpid()), 73)
+	parsed, err := parseHandoff(frame, uint32(os.Getpid()), 73)
+	if err != nil {
+		panic(err)
+	}
+	return parsed
+}
+
+func socketPair(t *testing.T) [2]int {
+	t.Helper()
+	pair, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_SEQPACKET|unix.SOCK_CLOEXEC, 0)
+	if err != nil {
+		t.Fatalf("create seqpacket pair: %v", err)
+	}
+	return pair
+}
+
+func closePair(pair [2]int) {
+	_ = unix.Close(pair[0])
+	_ = unix.Close(pair[1])
+}
+
+func sendHandoff(t *testing.T, controlFD int, reportFD int) {
+	t.Helper()
+	service := activeService.Load()
+	if service == nil {
+		t.Fatal("report service is not active")
+	}
+	frame := canonicalHandoffFrame(service.ownPID, service.ownStartTicks)
+	if _, err := unix.SendmsgN(controlFD, frame, unix.UnixRights(reportFD), nil, 0); err != nil {
+		t.Fatalf("send service handoff: %v", err)
+	}
+}
+
+func requireEndpointRetained(t *testing.T, fd int) {
+	t.Helper()
+	poll := []unix.PollFd{{Fd: int32(fd), Events: unix.POLLIN | unix.POLLHUP | unix.POLLERR}}
+	ready, err := unix.Poll(poll, 100)
+	if err != nil || ready != 0 {
+		t.Fatalf("report endpoint was not retained: ready=%d events=%#x err=%v", ready, poll[0].Revents, err)
+	}
+}
+
+func requireEOF(t *testing.T, fd int) {
+	t.Helper()
+	poll := []unix.PollFd{{Fd: int32(fd), Events: unix.POLLIN | unix.POLLHUP | unix.POLLERR}}
+	ready, err := unix.Poll(poll, 1000)
+	if err != nil || ready != 1 {
+		t.Fatalf("report EOF was not observable: ready=%d events=%#x err=%v", ready, poll[0].Revents, err)
+	}
+	buffer := make([]byte, 1)
+	length, err := unix.Read(fd, buffer)
+	if err != nil || length != 0 {
+		t.Fatalf("report endpoint did not reach EOF: length=%d err=%v", length, err)
+	}
+}
+
+func controlMessage(t *testing.T, level int32, kind int32, payload []byte) []byte {
+	t.Helper()
+	message := make([]byte, unix.CmsgSpace(len(payload)))
+	header := (*unix.Cmsghdr)(unsafe.Pointer(&message[0]))
+	header.Level = level
+	header.Type = kind
+	header.SetLen(unix.CmsgLen(len(payload)))
+	copy(message[unix.CmsgLen(0):], payload)
+	return message
+}
+
+func receiveRecord(t *testing.T, fd int, expected int) []byte {
+	t.Helper()
+	poll := []unix.PollFd{{Fd: int32(fd), Events: unix.POLLIN | unix.POLLHUP | unix.POLLERR}}
+	ready, pollErr := unix.Poll(poll, 1000)
+	if pollErr != nil || ready != 1 || poll[0].Revents&unix.POLLIN == 0 {
+		t.Fatalf("report record was not readable: ready=%d events=%#x err=%v", ready, poll[0].Revents, pollErr)
+	}
+	buffer := make([]byte, expected+1)
+	length, err := unix.Read(fd, buffer)
+	if err != nil {
+		t.Fatalf("receive report record: %v", err)
+	}
+	if length != expected {
+		t.Fatalf("report length=%d, want %d", length, expected)
+	}
+	return buffer[:length]
+}
+
+func testTCPPayloadObserver(t *testing.T, flow uint8) (*tcpPayloadObserver, int) {
+	t.Helper()
+	report := socketPair(t)
+	t.Cleanup(func() { closePair(report) })
+	binding := testBinding()
+	binding.requiredFlows = 1 << flow
+	expected, payload := expectedPayload(flow, binding.nonce)
+	attempt := &reportAttempt{binding: binding, reportFD: report[0], nextFlow: flow, sequence: 1}
+	return &tcpPayloadObserver{
+		service:  &reportService{active: attempt},
+		attempt:  attempt,
+		flow:     flow,
+		expected: expected,
+		payload:  payload,
+		buffer:   make([]byte, 0, len(expected)),
+	}, report[1]
+}
+
+func requireNoRecord(t *testing.T, fd int) {
+	t.Helper()
+	poll := []unix.PollFd{{Fd: int32(fd), Events: unix.POLLIN | unix.POLLHUP | unix.POLLERR}}
+	ready, err := unix.Poll(poll, 0)
+	if err != nil || ready != 0 {
+		t.Fatalf("unexpected report record: ready=%d events=%#x err=%v", ready, poll[0].Revents, err)
+	}
+}
+
+func requireTCPReportAndTerminal(t *testing.T, fd int, flow uint8) {
+	t.Helper()
+	delivery := receiveRecord(t, fd, tcpReportBytes)
+	if delivery[10] != reportKindTCP || delivery[reportHeaderBytes] != flow {
+		t.Fatalf("unexpected TCP report: %x", delivery)
+	}
+	terminal := receiveRecord(t, fd, terminalReportBytes)
+	if terminal[10] != reportKindTerminal || terminal[reportHeaderBytes] != 1 {
+		t.Fatalf("unexpected terminal report: %x", terminal)
+	}
+	requireEOF(t, fd)
+}
