+func TestTCPPayloadObserverRequiresExactPayloadBoundary(t *testing.T) {
+	type observation struct {
+		input []byte
+		err   error
+	}
+	nonce := bytes.Repeat([]byte{0x33}, 32)
+	var nonceArray [32]byte
+	copy(nonceArray[:], nonce)
+	dns, _ := expectedPayload(3, nonceArray)
+	invalidDNSLength := append([]byte(nil), dns...)
+	invalidDNSLength[1]--
+	for _, test := range []struct {
+		name       string
+		flow       uint8
+		observe    []observation
+		wantReport bool
+	}{
+		{name: "echo exact single read and EOF", observe: []observation{{input: nonce, err: io.EOF}}, wantReport: true},
+		{name: "echo fragmented then EOF", observe: []observation{{input: nonce[:7]}, {input: nonce[7:]}, {err: io.EOF}}, wantReport: true},
+		{name: "echo same-read suffix", observe: []observation{{input: append(append([]byte(nil), nonce...), 0xff), err: io.EOF}}},
+		{name: "echo later suffix before EOF", observe: []observation{{input: nonce}, {input: []byte{0xff}}, {err: io.EOF}}},
+		{name: "echo truncated EOF", observe: []observation{{input: nonce[:31], err: io.EOF}}},
+		{name: "DNS exact single read", flow: 3, observe: []observation{{input: dns}}, wantReport: true},
+		{name: "DNS fragmented", flow: 3, observe: []observation{{input: dns[:1]}, {input: dns[1:19]}, {input: dns[19:]}}, wantReport: true},
+		{name: "DNS same-read suffix", flow: 3, observe: []observation{{input: append(append([]byte(nil), dns...), 0xff)}}},
+		{name: "DNS invalid length", flow: 3, observe: []observation{{input: invalidDNSLength}}},
+		{name: "DNS truncated EOF", flow: 3, observe: []observation{{input: dns[:len(dns)-1], err: io.EOF}}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			observer, reportFD := testTCPPayloadObserver(t, test.flow)
+			for _, observation := range test.observe {
+				observer.observe(observation.input, observation.err)
+			}
+			if test.wantReport {
+				requireTCPReportAndTerminal(t, reportFD, test.flow)
+			} else {
+				requireNoRecord(t, reportFD)
+			}
+		})
+	}
+}
