+func TestReceiveHandoffRequiresCredentialsAndOneCloseOnExecSeqpacket(t *testing.T) {
+	control := socketPair(t)
+	report := socketPair(t)
+	defer closePair(control)
+	defer closePair(report)
+	if err := unix.SetsockoptInt(control[1], unix.SOL_SOCKET, unix.SO_PASSCRED, 1); err != nil {
+		t.Fatalf("enable credentials: %v", err)
+	}
+	frame := canonicalHandoffFrame(uint32(os.Getpid()), 73)
+	if _, err := unix.SendmsgN(control[0], frame, unix.UnixRights(report[0]), nil, 0); err != nil {
+		t.Fatalf("send handoff: %v", err)
+	}
+	received, descriptor, err := receiveHandoff(control[1])
+	if err != nil {
+		t.Fatalf("receive handoff: %v", err)
+	}
+	defer unix.Close(descriptor)
+	if !bytes.Equal(received, frame) {
+		t.Fatal("received handoff bytes changed")
+	}
+	flags, err := unix.FcntlInt(uintptr(descriptor), unix.F_GETFD, 0)
+	if err != nil || flags&unix.FD_CLOEXEC == 0 {
+		t.Fatalf("received endpoint lacks FD_CLOEXEC: flags=%d err=%v", flags, err)
+	}
+	if err := unix.Send(descriptor, []byte("proof"), 0); err != nil {
+		t.Fatalf("use received endpoint: %v", err)
+	}
+	buffer := make([]byte, 8)
+	length, err := unix.Read(report[1], buffer)
+	if err != nil || string(buffer[:length]) != "proof" {
+		t.Fatalf("read transferred endpoint: length=%d bytes=%q err=%v", length, buffer[:length], err)
+	}
+}
